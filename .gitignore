# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets (Never commit secrets)
.env
.env.*
!.env.example
!.env.*.example
!.env.development.example
!.env.staging.example
!.env.production.example

# Android local properties & build configs
local.properties
*.keystore
*.jks
*.p12

# Cloud Service Accounts & Private Keys
serviceAccountKey*.json
*service_account*.json
google-services.json
*.pem
*.key
*.cert
*.crt

# Build outputs
dist/
build/
.gradle/
**/build/
ValuationBackend/uploads/
**/uploads/
**/temp/
*.apk
*.aab

# Python & OCR temporary files
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
venv*/
.venv/
ocr_service/temp/
ocr_service/__pycache__/

# Large binary / OCR training data (downloaded at runtime by tesseract.js)
*.traineddata

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Editor
.idea/
.vscode/
*.swp

# Testing
coverage/

# Logs
*.log


# Server secret files (Firebase service account etc.) — never commit
ValuationBackend/secrets/

# ---------------------------------------------------------------------------
# Customer data, bank sample reports, database backups and test output — NEVER in Git
# (bank samples contain real customers' names, addresses and site photos)
# ---------------------------------------------------------------------------
ValuationBackend/services/reports/*_source/
ValuationBackend/backups/
reference_documents/
report-samples/
reports_output/
scratch/
UI_UX_REVIEW/SCREENSHOTS/
~$*.docx
