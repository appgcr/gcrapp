# ==============================================================================
# GCR ECOSYSTEM — COMPOSITE DEPLOYMENT STAGING TEMPLATE (.env.staging.example)
# Location: deployment/.env.staging.example
# ==============================================================================

# Backend Deployment (Render / Docker / VPS)
NODE_ENV=staging
PORT=5001
MONGODB_URI=mongodb+srv://staging_user:STAGING_DB_PASSWORD@staging-cluster.xxxxx.mongodb.net/gcr_valuation_staging?retryWrites=true&w=majority
JWT_SECRET=STAGING_JWT_SECRET_KEY_MIN_32_CHARACTERS_LONG_REQUIRED
JWT_REFRESH_SECRET=STAGING_REFRESH_SECRET_KEY_MIN_32_CHARACTERS_LONG
CORS_ALLOWED_ORIGINS=https://staging-admin.gcrvaluations.com
ENCRYPTION_KEY=STAGING_ENCRYPTION_KEY_32_BYTE_HEX

# Storage & Services
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=STAGING_CLOUDINARY_NAME
CLOUDINARY_API_KEY=STAGING_CLOUDINARY_KEY
CLOUDINARY_API_SECRET=STAGING_CLOUDINARY_SECRET

# Frontend Deployment (Vercel / Cloudflare Pages)
VITE_APP_NAME=GCR Valuation Admin (Staging)
VITE_APP_ENV=staging
VITE_API_BASE_URL=https://staging-api.gcrvaluations.com
VITE_MAP_PROVIDER=osm

# OCR Daemon Service
OCR_HOST=0.0.0.0
OCR_PORT=5002
OCR_SERVICE_URL=http://staging-ocr:5002
