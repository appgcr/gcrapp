# ==============================================================================
# GCR ECOSYSTEM — COMPOSITE DEPLOYMENT PRODUCTION TEMPLATE (.env.production.example)
# Location: deployment/.env.production.example
# ==============================================================================

# Backend Deployment (Docker / Kubernetes / AWS ECS / Render)
NODE_ENV=production
PORT=5001
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://prod_app_user:PRODUCTION_DB_PASSWORD@prod-cluster.xxxxx.mongodb.net/gcr_valuation_prod?retryWrites=true&w=majority
MONGODB_DATABASE=gcr_valuation_prod
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=5

# Mandatory Cryptographic Secrets (>= 32 chars)
JWT_SECRET=PRODUCTION_JWT_SECRET_KEY_MIN_32_CHARACTERS_MANDATORY
JWT_REFRESH_SECRET=PRODUCTION_REFRESH_SECRET_KEY_MIN_32_CHARACTERS_MANDATORY
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=PRODUCTION_ENCRYPTION_KEY_32_BYTE_HEX_MANDATORY

# Strict Production Domains & CORS
CORS_ALLOWED_ORIGINS=https://admin.gcrvaluations.com,https://portal.gcrvaluations.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Storage (Cloudinary Enterprise)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=PRODUCTION_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=PRODUCTION_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=PRODUCTION_CLOUDINARY_API_SECRET

# Microservices
OCR_ENABLED=true
OCR_SERVICE_URL=http://ocr-service.internal:5002

# Notifications & SMTP
FCM_ENABLED=true
FCM_PROJECT_ID=gcr-valuation-prod
FCM_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-prod-service-account.json

EMAIL_ENABLED=true
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=PRODUCTION_SMTP_USERNAME
SMTP_PASSWORD=PRODUCTION_SMTP_PASSWORD
EMAIL_FROM=GCR Valuations <reports@gcrvaluations.com>

# Monitoring
SENTRY_DSN=https://production_key@sentry.io/project_prod_id
SENTRY_ENVIRONMENT=production

# Frontend Production Deployment
VITE_APP_NAME=GCR Property Valuation Portal
VITE_APP_ENV=production
VITE_API_BASE_URL=https://api.gcrvaluations.com
VITE_MAP_PROVIDER=osm
