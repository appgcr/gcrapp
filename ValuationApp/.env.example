# ==============================================================================
# GCR VALUATION SYSTEM — FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# Application: ValuationApp (React 19 / Vite 5 / TailwindCSS / Leaflet)
# ==============================================================================
# SECURITY NOTICE:
# ALL VITE_* variables are bundled into client-side JavaScript and are publicly
# visible to any browser user. NEVER put private keys, JWT signing secrets,
# database credentials, or backend API secrets in this file.
# ==============================================================================

# Application Branding
VITE_APP_NAME=GCR Valuation Admin Portal
VITE_APP_ENV=development

# ValuationBackend REST API Base URL (Do not include trailing slash)
VITE_API_BASE_URL=http://localhost:5001
VITE_API_URL=http://localhost:5001

# Map Provider Configuration (Options: 'osm' for OpenStreetMap, 'google' for Google Maps)
VITE_ENABLE_MAP=true
VITE_MAP_PROVIDER=osm

# Telemetry & Monitoring (Optional)
VITE_ENABLE_ANALYTICS=false
VITE_SENTRY_DSN=
