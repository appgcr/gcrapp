# ==============================================================================
# GCR VALUATION SYSTEM — BACKEND STAGING TEMPLATE (.env.staging.example)
# Application: ValuationBackend
# Purpose: Pre-production QA, CI/CD automated integration, and UAT testing
# ==============================================================================

NODE_ENV=staging
APP_NAME=GCR_VALUATION_STAGING
APP_VERSION=1.0.0-rc1
PORT=5001
HOST=0.0.0.0
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Staging MongoDB Cluster (Isolated from Production)
MONGODB_URI=mongodb+srv://staging_user:STAGING_DB_PASSWORD@staging-cluster.xxxxx.mongodb.net/gcr_valuation_staging?retryWrites=true&w=majority
MONGODB_DATABASE=gcr_valuation_staging
MONGODB_MAX_POOL_SIZE=15
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000

# Staging Security Tokens
JWT_SECRET=GENERATE_STAGING_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=GENERATE_STAGING_REFRESH_SECRET_AT_LEAST_32_CHARS_LONG
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_ENCRYPTION_KEY_FOR_STAGING

# Staging Domains
CORS_ALLOWED_ORIGINS=https://staging-admin.gcrvaluations.com,https://staging-api.gcrvaluations.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
MAX_UPLOAD_SIZE_MB=25

WEBAUTHN_RP_NAME=GCR Valuations Staging
WEBAUTHN_RP_ID=staging-api.gcrvaluations.com
WEBAUTHN_ORIGIN=https://staging-admin.gcrvaluations.com

# Staging File Storage (Can use isolated Cloudinary folder or staging S3)
STORAGE_PROVIDER=cloudinary
LOCAL_UPLOAD_DIRECTORY=./uploads
MAX_DOCUMENT_SIZE_MB=25
MAX_IMAGE_SIZE_MB=10

CLOUDINARY_CLOUD_NAME=STAGING_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=STAGING_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=STAGING_CLOUDINARY_API_SECRET

# Staging OCR Daemon
OCR_ENABLED=true
OCR_SERVICE_URL=http://ocr-service:5002
OCR_LANGUAGE=eng+tel
OCR_TIMEOUT_MS=60000
PYTHON_PATH=

# Gemini AI (Optional staging test key)
GEMINI_ENABLED=false
GEMINI_API_KEY=STAGING_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# Staging Notifications & Email
FCM_ENABLED=false
FCM_PROJECT_ID=staging-gcr-valuation
FCM_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-staging-service-account.json

EMAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=STAGING_MAILTRAP_USERNAME
SMTP_PASSWORD=STAGING_MAILTRAP_PASSWORD
EMAIL_FROM=GCR Staging <staging-noreply@gcrvaluations.com>

# Monitoring
SENTRY_DSN=https://staging_key@sentry.io/project_staging_id
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.2

GOOGLE_MAPS_API_KEY=
EXTERNAL_API_TIMEOUT_MS=15000
