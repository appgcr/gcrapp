# ==============================================================================
# GCR VALUATION SYSTEM — BACKEND PRODUCTION TEMPLATE (.env.production.example)
# Application: ValuationBackend
# Purpose: High-security production deployment for live SBI Bank Panel valuations
# ==============================================================================

NODE_ENV=production
APP_NAME=GCR_VALUATION
APP_VERSION=1.0.0
PORT=5001
HOST=0.0.0.0
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=warn

# Production MongoDB Atlas Dedicated Cluster (Mandatory)
MONGODB_URI=mongodb+srv://prod_app_user:PRODUCTION_DB_PASSWORD@prod-cluster.xxxxx.mongodb.net/gcr_valuation_prod?retryWrites=true&w=majority
MONGODB_DATABASE=gcr_valuation_prod
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Production JWT Tokens (Mandatory >= 32 characters cryptographic random)
# Generate via: openssl rand -hex 32
JWT_SECRET=MANDATORY_PRODUCTION_SECURE_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=MANDATORY_PRODUCTION_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Mandatory 32-byte AES Key for Production Field Encryption
ENCRYPTION_KEY=MANDATORY_PRODUCTION_32_BYTE_HEX_ENCRYPTION_KEY

# Production HTTPS Domains Only (Strict CORS)
CORS_ALLOWED_ORIGINS=https://admin.gcrvaluations.com,https://portal.gcrvaluations.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_UPLOAD_SIZE_MB=25

WEBAUTHN_RP_NAME=GCR Property Valuations
WEBAUTHN_RP_ID=gcrvaluations.com
WEBAUTHN_ORIGIN=https://admin.gcrvaluations.com

# Production Cloud Storage (Cloudinary Enterprise / Secure Bucket)
STORAGE_PROVIDER=cloudinary
LOCAL_UPLOAD_DIRECTORY=./uploads
MAX_DOCUMENT_SIZE_MB=25
MAX_IMAGE_SIZE_MB=10

CLOUDINARY_CLOUD_NAME=PRODUCTION_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=PRODUCTION_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=PRODUCTION_CLOUDINARY_API_SECRET

# Production High-Accuracy OCR Daemon
OCR_ENABLED=true
OCR_SERVICE_URL=http://127.0.0.1:5002
OCR_LANGUAGE=eng+tel
OCR_TIMEOUT_MS=60000
PYTHON_PATH=/usr/bin/python3

# Google Gemini AI (Optional High-Fidelity Extraction)
GEMINI_ENABLED=true
GEMINI_API_KEY=PRODUCTION_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# Production Push Notifications (FCM)
FCM_ENABLED=true
FCM_PROJECT_ID=gcr-valuation-prod
FCM_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-prod-service-account.json

# Production Transactional Email (Corporate SMTP / AWS SES / SendGrid)
EMAIL_ENABLED=true
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=PRODUCTION_SMTP_USERNAME
SMTP_PASSWORD=PRODUCTION_SMTP_PASSWORD
EMAIL_FROM=GCR Valuations <reports@gcrvaluations.com>

# Production Error Telemetry (Sentry)
SENTRY_DSN=https://production_key@sentry.io/project_prod_id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# Production Map Provider (OpenStreetMap default or Google Maps Platform key)
GOOGLE_MAPS_API_KEY=
EXTERNAL_API_TIMEOUT_MS=15000
