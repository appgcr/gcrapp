# ==============================================================================
# GCR VALUATION SYSTEM — BACKEND DEVELOPMENT TEMPLATE (.env.development.example)
# Application: ValuationBackend
# Purpose: Local developer workstation (runs zero-cost local fallbacks)
# ==============================================================================

NODE_ENV=development
APP_NAME=GCR_VALUATION_DEV
APP_VERSION=1.0.0
PORT=5001
HOST=0.0.0.0
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# In development, leave empty to automatically launch in-memory MongoDB,
# or provide your local/Atlas dev connection string:
MONGODB_URI=
MONGODB_DATABASE=gcr_valuation_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Development JWT Secrets (Permissive for local development only)
JWT_SECRET=dev_only_super_secure_gcr_valuation_jwt_secret_key_2026_local
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev_only_super_secure_gcr_valuation_refresh_token_secret_2026
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
MAX_UPLOAD_SIZE_MB=50

# WebAuthn Local
WEBAUTHN_RP_NAME=GCR Valuations Dev
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Local File Storage
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIRECTORY=./uploads
MAX_DOCUMENT_SIZE_MB=50
MAX_IMAGE_SIZE_MB=25

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local OCR Engine
OCR_ENABLED=true
OCR_SERVICE_URL=http://127.0.0.1:5002
OCR_LANGUAGE=eng+tel
OCR_TIMEOUT_MS=60000
PYTHON_PATH=

# Gemini AI (Disabled by default locally — uses local OCR)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=1

# External services disabled for local dev
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

GOOGLE_MAPS_API_KEY=
EXTERNAL_API_TIMEOUT_MS=10000

# Report Archive Signing & Cryptographic Keyring (Phase 3.5.5.2)
# Required in all environments. The backend fails securely if unset.
ARCHIVE_SIGNING_KEY_ID=gcr-2026-k1
ARCHIVE_SIGNING_KEY=dev_workstation_archive_signing_key_secret_2026
# Optional multi-key keyring JSON for historical verification:
# ARCHIVE_KEYRING={"gcr-2026-k1":"secret1","gcr-2026-k2":"secret2"}
