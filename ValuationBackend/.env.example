# Backend environment — ValuationBackend (Node.js / Express)
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# DO NOT commit .env to git — it is gitignored.

PORT=5001

# ── MongoDB Atlas ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ── CORS: comma-separated list of allowed frontend origins ─
# After deploying frontend to Vercel, update this to the Vercel URL:
# e.g. FRONTEND_ORIGIN=https://gcrapp.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# ── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── WebAuthn (Passkeys) ────────────────────────────────────
# In production, set these to your Render domain:
WEBAUTHN_RP_NAME="GCR Valuations App"
WEBAUTHN_RP_ID=gcrapp.onrender.com
WEBAUTHN_ORIGIN=https://gcrapp.vercel.app

# ── Email / SMTP ───────────────────────────────────────────
EMAIL_USER=appgcr@gmail.com
EMAIL_PASS=your_app_password

# ── OCR (optional, runs in-process) ───────────────────────
DOCUMENT_AI_ENGINE=tesseract_ocr
USE_OPENSTREETMAP=true
GEOLOCATION_ENABLED=true
