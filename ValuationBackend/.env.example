# ==============================================================================
# GCR VALUATION SYSTEM — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Application: ValuationBackend (Node.js 24 / Express 4 / MongoDB Mongoose)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env (for local dev) or supply via platform secrets.
# 2. DO NOT commit actual credentials or .env to version control.
# 3. Required variables must be set. Optional services run only if *_ENABLED=true.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=GCR_VALUATION
APP_VERSION=1.0.0
PORT=5001
HOST=0.0.0.0
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# In development, if MONGODB_URI is empty, an automated in-memory MongoDB will launch.
# In staging/production, a valid MongoDB Atlas connection string is mandatory.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_DATABASE=gcr_valuation
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate 32+ byte cryptographically random strings: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_SECRET_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Symmetric AES-256 key for sensitive field-level encryption at rest (32 bytes hex)
ENCRYPTION_KEY=REPLACE_WITH_SECURE_32_BYTE_HEX_ENCRYPTION_KEY

# Comma-separated CORS allowed origins (e.g. http://localhost:5173,https://admin.gcrvaluations.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_UPLOAD_SIZE_MB=25

# ------------------------------------------------------------------------------
# 4. WEBAUTHN / BIOMETRIC PASSKEYS
# ------------------------------------------------------------------------------
WEBAUTHN_RP_NAME=GCR Valuations App
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. FILE STORAGE (Local vs Cloudinary)
# ------------------------------------------------------------------------------
# Options: 'local' (development/air-gapped) or 'cloudinary' (cloud CDN)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIRECTORY=./uploads
MAX_DOCUMENT_SIZE_MB=25
MAX_IMAGE_SIZE_MB=10

# Required ONLY IF STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ------------------------------------------------------------------------------
# 6. OCR SERVICE CONFIGURATION (Local Tesseract/PaddleOCR Engine)
# ------------------------------------------------------------------------------
OCR_ENABLED=true
OCR_SERVICE_URL=http://127.0.0.1:5002
OCR_LANGUAGE=eng+tel
OCR_TIMEOUT_MS=60000
PYTHON_PATH=

# ------------------------------------------------------------------------------
# 7. GOOGLE GEMINI AI (Required: reads deeds, plans, certificates; rejects wrong documents)
# ------------------------------------------------------------------------------
# When GEMINI_ENABLED=false, the system relies 100% on local offline OCR.
GEMINI_ENABLED=false
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 8. PUSH NOTIFICATIONS (Firebase Cloud Messaging - Optional)
# ------------------------------------------------------------------------------
FCM_ENABLED=false
FCM_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FCM_SERVICE_ACCOUNT_PATH=./config/credentials/firebase-service-account.json

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAIL (SMTP - Optional)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
EMAIL_FROM=GCR Valuations <no-reply@gcrvaluations.com>

# ------------------------------------------------------------------------------
# 10. MONITORING & OBSERVABILITY (Sentry - Optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# 11. EXTERNAL INTEGRATIONS (Maps & Geolocation)
# ------------------------------------------------------------------------------
# OpenStreetMap tile server is the free default. Google Maps is optional.
GOOGLE_MAPS_API_KEY=
EXTERNAL_API_TIMEOUT_MS=15000
