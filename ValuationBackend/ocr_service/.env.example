# ==============================================================================
# GCR VALUATION SYSTEM — IN-TREE OCR SERVICE TEMPLATE (.env.example)
# Location: ValuationBackend/ocr_service/.env.example
# ==============================================================================

PYTHON_ENV=development
OCR_HOST=127.0.0.1
OCR_PORT=5002
OCR_LANGUAGE=eng+tel
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_TIMEOUT_SECONDS=60
OCR_MAX_FILE_SIZE_MB=25
OCR_TEMP_DIRECTORY=./temp
OCR_LOG_LEVEL=INFO
PDF_DPI=300
IMAGE_PREPROCESSING_ENABLED=true
OCR_PARALLEL_WORKERS=2

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
