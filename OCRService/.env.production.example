# ==============================================================================
# GCR VALUATION SYSTEM — OCR SERVICE PRODUCTION TEMPLATE (.env.production.example)
# ==============================================================================

PYTHON_ENV=production
OCR_HOST=0.0.0.0
OCR_PORT=5002
OCR_LANGUAGE=eng+tel
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
OCR_TIMEOUT_SECONDS=60
OCR_MAX_FILE_SIZE_MB=25
OCR_TEMP_DIRECTORY=/tmp/gcr_ocr
OCR_LOG_LEVEL=WARNING
PDF_DPI=300
IMAGE_PREPROCESSING_ENABLED=true
OCR_PARALLEL_WORKERS=4

# Production Gemini AI fallback (Set to true if API key provided)
GEMINI_ENABLED=false
GEMINI_API_KEY=PRODUCTION_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
