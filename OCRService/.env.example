# ==============================================================================
# GCR VALUATION SYSTEM — OCR SERVICE ENVIRONMENT TEMPLATE (.env.example)
# Application: OCRService / Python Document Extraction Engine
# Technologies: Python 3.10+ / OpenCV / PaddleOCR / Tesseract / pypdfium2
# ==============================================================================

PYTHON_ENV=development
OCR_HOST=127.0.0.1
OCR_PORT=5002
OCR_LANGUAGE=eng+tel
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_TIMEOUT_SECONDS=60
OCR_MAX_FILE_SIZE_MB=25
OCR_TEMP_DIRECTORY=./temp
OCR_LOG_LEVEL=INFO
PDF_DPI=300
IMAGE_PREPROCESSING_ENABLED=true
OCR_PARALLEL_WORKERS=2

# Gemini AI Vision Fallback (Optional)
# If disabled, OCR functions purely offline on local CPU/GPU models
GEMINI_ENABLED=false
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
